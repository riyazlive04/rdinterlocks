{
  "name": "rd-interlock-factory-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx scripts/e2e/run-nav.ts && tsx scripts/e2e/run-offline.ts",
    "test:db": "tsx scripts/e2e/run-rbac.ts && tsx scripts/e2e/run-actions.ts && tsx scripts/e2e/run-collections.ts && tsx scripts/e2e/run-allocation.ts && tsx scripts/e2e/run-db.ts",
    "test:pdf": "tsx scripts/e2e/run-pdf.ts",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:db",
    "test:seed": "node scripts/guard-local-db.mjs && prisma db push --skip-generate && tsx prisma/seed.ts && tsx prisma/seed-delivery-zones.ts --apply && tsx prisma/seed-brick-prices.ts --apply && tsx prisma/seed-quote-settings.ts --apply && tsx prisma/backfill-lead-stages.ts --apply",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-lead-stages": "tsx prisma/backfill-lead-stages.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "webhook:test": "node scripts/post-lead-webhook.mjs",
    "cron:tick": "node scripts/run-tick.mjs",
    "cron:sweep": "node scripts/run-sweep.mjs",
    "db:zones": "tsx prisma/seed-delivery-zones.ts",
    "db:prices": "tsx prisma/seed-brick-prices.ts",
    "db:quote-settings": "tsx prisma/seed-quote-settings.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sparticuz/chromium": "^149.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.2",
    "jose": "^5.9.6",
    "next": "^15.5.19",
    "pdfkit": "^0.15.1",
    "puppeteer-core": "^25.7.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
