# Copy to .env and fill in actual values

# Supabase Postgres — get from Project Settings → Database → Connection string
# Transaction pooler (used by the app at runtime, port 6543, with pgbouncer=true)
DATABASE_URL="postgres://postgres.<ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (used by Prisma migrations + seeding, port 5432)
DIRECT_URL="postgres://postgres.<ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Long random string. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# Initial admin password — applied on first seed. The owner can change it later.
DEFAULT_PASSWORD="Admin@123"

# Set to "true" only when deploying behind HTTPS (Vercel, Cloudflare, etc.).
# Leave off (or set to "false") for localhost development.
COOKIE_SECURE="false"

# API keys for machine-to-machine integrations (e.g. the Transcriber posting to
# /api/v1/leads/import). Comma-separated; each entry is `label:key`. The label
# is written to the import audit log so a specific credential can be traced and
# revoked. Listing more than one is how you rotate: add the new key, let the
# caller switch over, then remove the old entry.
# Generate a key with: openssl rand -hex 32
INTEGRATION_API_KEYS="transcriber-prod:change-me-to-a-long-random-key"

# Rate limits for /api/v1/leads/import. All optional — the defaults shown are
# used when unset. Counters are per server instance (see src/lib/rate-limit.ts).
# LEADS_RATE_LIMIT_PER_MINUTE="60"      # accepted requests per API key
# LEADS_RATE_LIMIT_IP_PER_MINUTE="120"  # total requests per client IP
# LEADS_AUTH_FAILURES_PER_15_MIN="10"   # bad-key attempts before an IP is blocked

# ─── Inbound lead webhooks (/api/v1/leads/webhook/<channel>) ──────────────
# Provider-agnostic intake: a relay or agency dashboard posts the lead's field
# data inline and signs it with a shared secret. Use this (not the Meta block
# below) for anyone who is not Facebook itself — it needs no Graph token and
# makes no outbound call. The contract to hand the provider is
# docs/lead-webhook-contract.md.
#
# A JSON array. Only `channel` and `secret` are required; the rest default to
# the published contract (HMAC-SHA256 hex over "<timestamp>.<raw body>", in
# X-RD-Signature with an X-RD-Timestamp inside a 5-minute replay window):
#
#   LEAD_WEBHOOK_CHANNELS='[{"channel":"metarelay","secret":"<openssl rand -hex 32>"}]'
#
# Issue one channel per provider AND per environment — that is how a staging
# integration is kept from writing to live leads, and how one provider's
# leaked secret is revoked without disturbing the others.
#
# Optional per-channel keys:
#   scheme            hmac-sha256-hex (default) | hmac-sha256-base64
#                     | hmac-sha256-hex-body (no replay protection)
#                     | bearer (static token; no body integrity — last resort)
#   signatureHeader   default "x-rd-signature"
#   signaturePrefix   default "sha256="   (empty string for none)
#   timestampHeader   default "x-rd-timestamp"
#   toleranceSeconds  default 300; 0 disables the replay window
#   source            value written to Lead.source, default "meta"
#   fieldMap          {"their_field":"customerName"} — only needed when the
#                     provider's names match none of the built-in aliases
LEAD_WEBHOOK_CHANNELS='[]'

# ─── Meta Lead Ads ingestion (/api/v1/leads/meta/*) ───────────────────────
# App secret from the Meta App dashboard — used to verify X-Hub-Signature-256
# on every webhook delivery (HMAC-SHA256 over the raw request body).
META_APP_SECRET="change-me"
# Arbitrary string YOU choose and also enter in the Meta webhook subscription
# config. Verified against hub.verify_token on the GET challenge request.
META_VERIFY_TOKEN="change-me-to-a-long-random-string"
# Page access token used server-side to call the Graph API and fetch
# field_data for a leadgen_id. Never exposed to the client.
META_PAGE_ACCESS_TOKEN="change-me"

# ─── WhatsApp Cloud API nurturing (/api/v1/whatsapp/*) ────────────────────
WHATSAPP_PHONE_NUMBER_ID="change-me"
WHATSAPP_ACCESS_TOKEN="change-me"

# Bearer key for Vercel Cron to call POST /api/v1/whatsapp/tick. Same
# fail-closed constant-time comparison as INTEGRATION_API_KEYS — deliberately
# a separate credential so a leaked Transcriber/Meta key can't trigger sends.
# Generate with: openssl rand -hex 32
CRON_API_KEY="change-me-to-a-long-random-key"

# ─── Quotation PDF rendering (GET /api/quote/[id]/pdf) ────────────────────
# The quotation PDF is rendered by headless Chromium (needed for correct
# Tamil script shaping — see lib/pdf-render.ts). In production (Vercel)
# @sparticuz/chromium supplies the browser automatically, nothing to set.
# For LOCAL development only, point this at an installed Chrome/Edge binary
# — Edge ships with Windows and works unmodified. Typical Windows path:
# CHROME_EXECUTABLE_PATH="C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe"

# ─── Facebook/Instagram Lead Ads backfill (scripts/pull-facebook-leads.ts) ─
# The upstream relay that has been collecting this page's Lead Ads
# submissions since before this CRM's own webhook was subscribed. Exposed as
# a cursored JSON export; see src/lib/facebook-feed.ts for why it's a
# separate channel from /api/v1/leads/meta/*.
FACEBOOK_FEED_URL="https://<relay-host>/api/export/facebook-leads"
# Read-only export token issued by the relay. Travels in the query string, so
# treat it as a credential: rotate it there, never commit it here.
FACEBOOK_FEED_TOKEN="change-me"
