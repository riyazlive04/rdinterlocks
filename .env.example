# Copy to .env and fill in actual values

# Supabase Postgres — get from Project Settings → Database → Connection string
# Transaction pooler (used by the app at runtime, port 6543, with pgbouncer=true)
DATABASE_URL="postgres://postgres.<ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (used by Prisma migrations + seeding, port 5432)
DIRECT_URL="postgres://postgres.<ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Long random string. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# Initial admin password — applied on first seed. The owner can change it later.
DEFAULT_PASSWORD="Admin@123"

# Set to "true" only when deploying behind HTTPS (Vercel, Cloudflare, etc.).
# Leave off (or set to "false") for localhost development.
COOKIE_SECURE="false"

# API keys for machine-to-machine integrations (e.g. the Transcriber posting to
# /api/v1/leads/import). Comma-separated; each entry is `label:key`. The label
# is written to the import audit log so a specific credential can be traced and
# revoked. Listing more than one is how you rotate: add the new key, let the
# caller switch over, then remove the old entry.
# Generate a key with: openssl rand -hex 32
INTEGRATION_API_KEYS="transcriber-prod:change-me-to-a-long-random-key"

# Rate limits for /api/v1/leads/import. All optional — the defaults shown are
# used when unset. Counters are per server instance (see src/lib/rate-limit.ts).
# LEADS_RATE_LIMIT_PER_MINUTE="60"      # accepted requests per API key
# LEADS_RATE_LIMIT_IP_PER_MINUTE="120"  # total requests per client IP
# LEADS_AUTH_FAILURES_PER_15_MIN="10"   # bad-key attempts before an IP is blocked
