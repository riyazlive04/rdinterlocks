generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ──────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  name        String
  pinHash     String
  role        String   @default("admin") // admin (full) | manager | staff
  active      Boolean  @default(true)
  permissions String[] @default([]) // area keys granted (ignored for admin)
  createdAt   DateTime @default(now())
}

// ─── Master data (admin-managed) ──────────────────────────────────────

model Settings {
  id              String  @id @default("default")
  factoryName     String  @default("RD Interlock Bricks")
  ownerName       String  @default("Admin")
  address         String  @default("")
  phone           String  @default("")
  gstin           String  @default("")
  cementBagsPer1000 Float @default(18) // recipe ratio, for material reconciliation
  materialBasis   Int     @default(1000) // recipe quantities are "per this many bricks"
  cashOpening     Float   @default(0)
  weekStartDay    Int     @default(1) // 0 sun, 1 mon
  settlementDay   Int     @default(6) // 6 sat
  // Default piece-rates by shift, used for quick-pick on production entry
  dayShiftRate    Float   @default(2.5)
  nightShiftRate  Float   @default(3.0)
  // Stock curing pipeline thresholds (days since produced). A batch is:
  // Produced (day 0) -> Drying (1..dryingDays) -> Curing (..curingDays) -> Ready.
  dryingDays      Int     @default(3)
  curingDays      Int     @default(10)
  // Default salary settlement cadence per worker type (weekly | monthly).
  // Employees are set individually on each employee instead.
  operatorPayFreq String  @default("weekly")
  loaderPayFreq   String  @default("weekly")
  masonPayFreq    String  @default("weekly")
}

model Machine {
  id     String  @id @default(cuid())
  name   String  @unique // "Machine A", "Machine B"
  active Boolean @default(true)
  order  Int     @default(0)

  productionEntries ProductionEntry[]
}

// Material recipe per brick size: how many units of each material per 1000 bricks
model MaterialRecipe {
  id          String    @id @default(cuid())
  brickSizeId String
  brickSize   BrickSize @relation(fields: [brickSizeId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  qtyPer1000  Float

  @@unique([brickSizeId, materialId])
}

// Current stock level for each material (admin can set + auto-decremented on production)
model MaterialStock {
  id         String   @id @default(cuid())
  materialId String   @unique
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity   Float    @default(0)
  reorderAt  Float    @default(0) // alert when stock goes below this
  updatedAt  DateTime @updatedAt
}

model BrickSize {
  id    String @id @default(cuid())
  label String @unique // e.g. "6\"", "6\"H", "8\""
  order Int    @default(0)
  // Operator piece-rate for this size by shift. 0 = fall back to the global
  // day/night rate in Settings.
  dayRate   Float @default(0)
  nightRate Float @default(0)

  prices         BrickPrice[]
  productionEntries ProductionEntry[]
  stockBatches      StockBatch[]
  masonWorks        MasonWork[]
  loadingWorks      LoadingWork[]
  orderItems        OrderItem[]
  deliveryItems     DeliveryItem[]
  tipperLoads       TipperLoad[]
  recipes           MaterialRecipe[]
  leads             Lead[]
}

model ConstructionType {
  id    String @id @default(cuid())
  name  String @unique // Room, Compound, Godown, Foundation, Boundary…
  order Int    @default(0)

  prices         BrickPrice[]
  masonWorks     MasonWork[]
  orderItems     OrderItem[]
  deliveryItems  DeliveryItem[]
  leads          Lead[]
}

// Pricing matrix: each (size × constructionType) has sellPrice + masonRate
model BrickPrice {
  id                 String  @id @default(cuid())
  brickSizeId        String
  brickSize          BrickSize        @relation(fields: [brickSizeId], references: [id], onDelete: Cascade)
  constructionTypeId String
  constructionType   ConstructionType @relation(fields: [constructionTypeId], references: [id], onDelete: Cascade)
  sellPrice          Float            // ₹ per brick to client
  masonRate          Float            // ₹ per brick paid to mason for this combination
  productionCost     Float    @default(0) // ₹ per brick estimated production cost
  active             Boolean  @default(true)

  @@unique([brickSizeId, constructionTypeId])
}

model ExpenseCategory {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  expenses Expense[]
}

model Material {
  id    String  @id @default(cuid())
  name  String  @unique // Cement, Flyash, Powder, Chips, Admixer, Sludge
  unit  String  @default("bag") // bag, kg, ton, ltr, nos
  order Int     @default(0)

  recipes MaterialRecipe[]
  stock   MaterialStock?
}

// ─── People ────────────────────────────────────────────────────────────

model Operator {
  id       String   @id @default(cuid())
  name     String
  phone    String?
  joinedAt DateTime @default(now())
  active   Boolean  @default(true)

  productionShares ProductionShare[]
  advances         Advance[]
  loadingWorks     LoadingWork[]
  payouts          WorkerPayout[]
  leaves           Leave[]
}

model Mason {
  id       String   @id @default(cuid())
  name     String
  phone    String?
  joinedAt DateTime @default(now())
  active   Boolean  @default(true)

  works    MasonWork[]
  advances Advance[]
  payouts  WorkerPayout[]
  leaves   Leave[]
}

model Loader {
  id       String   @id @default(cuid())
  name     String
  phone    String?
  joinedAt DateTime @default(now())
  active   Boolean  @default(true)

  works    LoadingWork[]
  advances Advance[]
  payouts  WorkerPayout[]
  leaves   Leave[]
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("staff") // staff, driver, watchman, etc.
  payType   String   @default("monthly") // monthly | daily | hourly
  payRate   Float    @default(0) // ₹ per period
  payFrequency String @default("monthly") // weekly | monthly - salary settlement cadence
  phone     String?
  joinedAt  DateTime @default(now())
  active    Boolean  @default(true)

  attendance EmployeeAttendance[]
  advances   Advance[]
  payouts    EmployeePayout[]
  loadingWorks LoadingWork[]
  workerPayouts WorkerPayout[]
  leaves     Leave[]
}

model Vendor {
  id      String  @id @default(cuid())
  name    String  @unique // AVM, etc.
  phone   String?
  notes   String?
  active  Boolean @default(true)

  tippers     Tipper[]
  expenses    Expense[]
  tipperLoads TipperLoad[]
  loadingCharges LoadingCharge[]
}

model Tipper {
  id        String   @id @default(cuid())
  name      String   // RD Tipper, AVM Tipper
  plate     String?
  ownership String   @default("own") // own | vendor
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  emiAmount Float    @default(0) // monthly EMI if own
  active    Boolean  @default(true)

  loads        TipperLoad[]
  loadingWorks LoadingWork[]
}

model Client {
  id       String   @id @default(cuid())
  name     String
  location String?  // city/town
  phone    String?
  notes    String?
  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  orders Order[]
  payments ClientPayment[]
  loadingWorks LoadingWork[]
  loadingCharges LoadingCharge[]
  leads Lead[]
}

// ─── Operations ────────────────────────────────────────────────────────

// Production = a batch of bricks made by 1+ operators on a date.
model ProductionEntry {
  id                 String   @id @default(cuid())
  date               DateTime
  shift              String   @default("day") // day | night
  machineId          String?
  machine            Machine? @relation(fields: [machineId], references: [id])
  brickSizeId        String
  brickSize          BrickSize @relation(fields: [brickSizeId], references: [id])
  cementBagsUsed     Float    @default(0)
  brickCount         Int
  damagedCount       Int      @default(0)
  ratePerBrick       Float    // operator piece rate (split across operators)
  totalWage          Float    // brickCount × rate (auto-calculated, frozen on save)
  notes              String?
  createdAt          DateTime @default(now())

  shares  ProductionShare[]
  batch   StockBatch?
  @@index([date])
}

model ProductionShare {
  id                 String  @id @default(cuid())
  productionEntryId  String
  productionEntry    ProductionEntry @relation(fields: [productionEntryId], references: [id], onDelete: Cascade)
  operatorId         String
  operator           Operator @relation(fields: [operatorId], references: [id])
  brickCount         Int     @default(0) // share of brickCount (rounded so sum equals total)
  amount             Float   // share of totalWage (rounded so sum equals total)
}

model StockBatch {
  id                String   @id @default(cuid())
  code              String   @unique // B-001
  brickSizeId       String
  brickSize         BrickSize @relation(fields: [brickSizeId], references: [id])
  productionEntryId String?  @unique
  productionEntry   ProductionEntry? @relation(fields: [productionEntryId], references: [id])
  count             Int
  remaining         Int
  stage             String   @default("produced") // produced | drying | curing | ready | dispatched
  // production = made here, so it ages produced -> drying -> curing -> ready.
  // return = bricks that came back on a tipper. They were cured long ago, so
  // they count as READY immediately instead of being aged from producedAt.
  source            String   @default("production") // production | return
  producedAt        DateTime @default(now())
  stageChangedAt    DateTime @default(now())

  tipperReturn      TipperLoad?

  @@index([stage])
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime        @default(now())
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  title       String
  amount      Float
  notes       String?
  vendorId    String?
  vendor      Vendor?         @relation(fields: [vendorId], references: [id])
  tipperId    String?         // expenses tagged to a tipper (diesel, oil, EMI, etc.)
  cashEntryId String?         @unique
  cashEntry   CashEntry?      @relation(fields: [cashEntryId], references: [id])

  @@index([date])
}

// Tipper loads = either income (delivering bricks/RM for a fee) OR
// an internal use record (own RD tipper carrying our own bricks — no income).
model TipperLoad {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  // Set when this load was auto-created from a loading entry, so the two stay
  // linked for edits/deletes.
  loadGroupId String?
  tipperId    String
  tipper      Tipper   @relation(fields: [tipperId], references: [id])
  vendorId    String?  // if vendor-owned
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  loadType    String   // bricks | material
  brickSizeId String?
  brickSize   BrickSize? @relation(fields: [brickSizeId], references: [id])
  materialName String? // when loadType=material
  quantity    Float
  unit        String   @default("pcs")
  fromLocation String?
  toLocation   String?
  rentAmount   Float    @default(0) // earned (or paid if vendor)
  rentDirection String  @default("in") // in (we earn) | out (we pay vendor)
  // Bricks brought BACK on this trip (customer return / undelivered load).
  // They go straight back into sellable stock via the linked return batch.
  returnBricks  Int     @default(0)
  returnBatchId String? @unique
  returnBatch   StockBatch? @relation(fields: [returnBatchId], references: [id])
  notes        String?
  cashEntryId  String?  @unique
  cashEntry    CashEntry? @relation(fields: [cashEntryId], references: [id])

  @@index([date])
}

model MasonWork {
  id                String   @id @default(cuid())
  date              DateTime @default(now())
  masonId           String
  mason             Mason    @relation(fields: [masonId], references: [id])
  siteName          String
  brickSizeId       String
  brickSize         BrickSize @relation(fields: [brickSizeId], references: [id])
  constructionTypeId String
  constructionType  ConstructionType @relation(fields: [constructionTypeId], references: [id])
  brickCount        Int
  ratePerBrick      Float
  totalAmount       Float
  notes             String?

  @@index([date])
}

// Loading work can be done by a loader, an operator, or an employee (driver).
// workerType says which one; the matching FK is set, the others are null.
model LoadingWork {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  phase        String   @default("loading") // loading | unloading
  loadType     String   @default("brick") // brick | lintel (lintel slabs)
  workerType   String   @default("loader") // loader | operator | employee
  // One physical load splits into several rows (one per worker / phase). They
  // share a loadGroupId so the tipper, add-on charges and cash entries can be
  // attached to the load as a whole and edited/deleted together.
  loadGroupId  String?
  loaderId     String?
  loader       Loader?   @relation(fields: [loaderId], references: [id])
  operatorId   String?
  operator     Operator? @relation(fields: [operatorId], references: [id])
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id])
  brickSizeId  String?
  brickSize    BrickSize? @relation(fields: [brickSizeId], references: [id])
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  tipperId     String?
  tipper       Tipper?   @relation(fields: [tipperId], references: [id])
  vehicleRequested String?  // free text: what vehicle the customer asked for
  brickCount   Int
  ratePerBrick Float
  totalAmount  Float
  notes        String?

  @@index([date])
  @@index([loadGroupId])
}

// Extra products / services billed on a loading trip: shifting charge, lintel
// slab, cement, etc. direction=in means we sold it to the customer (income);
// direction=out means we bought it from a vendor (expense). Each line owns its
// cash-book entry so editing/zeroing/deleting the load keeps accounts in step.
model LoadingCharge {
  id          String   @id @default(cuid())
  loadGroupId String
  date        DateTime @default(now())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  name        String
  direction   String   @default("in") // in (income) | out (expense)
  quantity    Float    @default(1)
  unit        String   @default("unit")
  amount      Float    // total for the line
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  cashEntryId String?  @unique
  cashEntry   CashEntry? @relation(fields: [cashEntryId], references: [id])

  @@index([loadGroupId])
}

// ─── Sales: Order → Deliveries → Payments ─────────────────────────────

// Lintel slab sizes (e.g. 4, 5, 6). Admin-managed master data, used on orders.
model SlabSize {
  id    String @id @default(cuid())
  label String @unique // e.g. "4", "5", "6"
  order Int    @default(0)

  orderSlabItems OrderSlabItem[]
}

model Order {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  date        DateTime @default(now())
  expectedDeliveryDate DateTime?
  status      String   @default("open") // open | partial | complete | cancelled
  notes       String?

  items     OrderItem[]
  slabItems OrderSlabItem[]
  deliveries Delivery[]
  payments   ClientPayment[]
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brickSizeId        String
  brickSize          BrickSize @relation(fields: [brickSizeId], references: [id])
  constructionTypeId String
  constructionType   ConstructionType @relation(fields: [constructionTypeId], references: [id])
  quantity           Int
  pricePerBrick      Float
  total              Float
}

// A lintel-slab line on an order (kept separate from the brick OrderItem).
// Priced per slab; pricePerSlab may be 0 to record slabs as spec-only.
model OrderSlabItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slabSizeId   String
  slabSize     SlabSize @relation(fields: [slabSizeId], references: [id])
  quantity     Int      // number of slabs
  pricePerSlab Float    @default(0)
  total        Float    @default(0)
}

model Delivery {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  vehicleId    String?  // optional Tipper used
  truckPlate   String?
  notes        String?
  completedAt  DateTime? // set when the owner marks the delivery done (evening check)

  items     DeliveryItem[]
  addOns    DeliveryAddOn[]
  returns   DeliveryReturn[]

  @@index([date])
}

model DeliveryItem {
  id                 String   @id @default(cuid())
  deliveryId         String
  delivery           Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  brickSizeId        String
  brickSize          BrickSize @relation(fields: [brickSizeId], references: [id])
  constructionTypeId String
  constructionType   ConstructionType @relation(fields: [constructionTypeId], references: [id])
  quantity           Int
  pricePerBrick      Float
  total              Float
}

model DeliveryAddOn {
  id          String   @id @default(cuid())
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  name        String   // Cement, Lintel slab, Loading charges, etc.
  quantity    Float
  unit        String   @default("unit")
  pricePerUnit Float
  total       Float
}

model DeliveryReturn {
  id          String   @id @default(cuid())
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  brickCount  Int
  refundAmount Float
  notes       String?
}

model ClientPayment {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  date      DateTime @default(now())
  amount    Float
  method    String   @default("cash") // cash | gpay | bank | upi | cheque
  notes     String?
  cashEntryId String? @unique
  cashEntry   CashEntry? @relation(fields: [cashEntryId], references: [id])
}

// ─── Employees: attendance + salary + advance ─────────────────────────

model EmployeeAttendance {
  id         String   @id @default(cuid())
  date       DateTime
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  status     String   // present | absent | leave | half

  @@unique([date, employeeId])
}

model EmployeePayout {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  baseAmount  Float
  bonus       Float    @default(0)
  deductions  Float    @default(0)
  advancesSettled Float @default(0)
  netPaid     Float
  notes       String?
  cashEntryId String?  @unique
  cashEntry   CashEntry? @relation(fields: [cashEntryId], references: [id])
}

// Generic wage/salary payout for ANY worker type (operator, mason, loader,
// employee). Mirrors EmployeePayout but works for everyone, so the payroll
// screen can settle anyone in one place. (EmployeePayout is kept for the
// existing employee-page flow; payroll sums both.)
model WorkerPayout {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  personType  String   // operator | mason | loader | employee
  operatorId  String?
  operator    Operator? @relation(fields: [operatorId], references: [id])
  masonId     String?
  mason       Mason?    @relation(fields: [masonId], references: [id])
  loaderId    String?
  loader      Loader?   @relation(fields: [loaderId], references: [id])
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  earned          Float @default(0) // earned in the period (snapshot)
  advancesSettled Float @default(0) // advance deducted in this payout
  netPaid         Float            // cash actually handed over
  notes       String?
  cashEntryId String?  @unique
  cashEntry   CashEntry? @relation(fields: [cashEntryId], references: [id])

  @@index([date])
}

// A marked day off for ANY worker (operator, loader, mason, employee). Only
// LEAVES are recorded — an unmarked day is a working day. Used in payroll and
// the salary report (informational, and reduces daily-paid employee earnings).
model Leave {
  id         String    @id @default(cuid())
  date       DateTime
  personType String // operator | loader | mason | employee
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id])
  masonId    String?
  mason      Mason?    @relation(fields: [masonId], references: [id])
  loaderId   String?
  loader     Loader?   @relation(fields: [loaderId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  reason     String?
  createdAt  DateTime  @default(now())

  @@index([date])
}

// ─── Generic Advance (any person type) ────────────────────────────────

model Advance {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  personType String  // operator | mason | loader | employee
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id])
  masonId    String?
  mason      Mason?   @relation(fields: [masonId], references: [id])
  loaderId   String?
  loader     Loader?  @relation(fields: [loaderId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  amount     Float
  notes      String?
  settled    Boolean  @default(false)
  cashEntryId String? @unique
  cashEntry   CashEntry? @relation(fields: [cashEntryId], references: [id])

  @@index([date])
}

// ─── Leads (inbound enquiries from the Transcriber integration) ───────

// A pre-sale enquiry, extracted from a recorded call by the Transcriber app
// and pushed to POST /api/v1/leads/import.
//
// Everything here is best-effort: a transcript may not mention the place, the
// quantity, or the price. Missing text fields are stored as "" and missing
// numbers/dates as null, so a partial extraction is still captured rather than
// rejected. Whatever the extractor DID hear is never lost — the verbatim
// payload of every request is kept in LeadImport.
model Lead {
  id     String @id @default(cuid())
  // Idempotency key: one recorded call = one lead. Re-sending the same callId
  // (e.g. after the Transcriber re-runs its extraction) updates this row
  // instead of creating a duplicate.
  callId String @unique

  customerName     String    @default("")
  place            String    @default("")
  brickType        String    @default("") // as spoken, e.g. "6 inch"
  brickCount       Int?
  constructionType String    @default("") // as spoken, e.g. "compound wall"
  costPerBrick     Float?
  totalBudget      Float?
  notes            String    @default("")
  followUpDate     DateTime?
  // new | quoted | negotiating | won | lost. Unrecognised values are stored
  // verbatim so the Transcriber can introduce a new stage without a deploy.
  quotationStage   String    @default("new")

  // Best-effort links to master data, set when the spoken text matches a known
  // brick size / construction type. Null when it doesn't — the free text above
  // stays the source of truth and conversion falls back to it.
  brickSizeId        String?
  brickSize          BrickSize?        @relation(fields: [brickSizeId], references: [id])
  constructionTypeId String?
  constructionTypeRef ConstructionType? @relation(fields: [constructionTypeId], references: [id])

  // Fields the Transcriber sends that this schema version doesn't model yet.
  // Lets new extracted fields ship without a migration or a broken integration.
  extra Json?

  source String @default("transcriber")
  status String @default("open") // open | converted | discarded

  // Set when the lead becomes a real customer. A converted lead is locked:
  // further imports for the same callId are refused with 409 rather than
  // silently overwriting a record the office has already acted on.
  convertedClientId String?
  convertedClient   Client?   @relation(fields: [convertedClientId], references: [id])
  convertedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imports LeadImport[]

  @@index([quotationStage])
  @@index([followUpDate])
  @@index([createdAt])
  @@index([status])
}

// Append-only audit of every import request, including the ones that were
// rejected or refused. `payload` is the body exactly as received, so a bad
// extraction can always be replayed or diffed after the fact.
model LeadImport {
  id     String  @id @default(cuid())
  callId String?
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  payload    Json // verbatim request body
  outcome    String // created | updated | rejected | conflict | error
  statusCode Int
  message    String @default("")
  // Which credential was used, for revocation/forensics. Never the key itself.
  apiKeyLabel String @default("")
  requestId   String

  receivedAt DateTime @default(now())

  @@index([callId])
  @@index([receivedAt])
  @@index([outcome])
}

// ─── Unified Cashbook ─────────────────────────────────────────────────

// One row per real cash movement. Auto-created from operations
// (Expense, ClientPayment, EmployeePayout, Advance, TipperLoad with rent).
// Direct rows can also be added by admin (sundry receipt/payment).
model CashEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  amount      Float
  direction   String   // in | out
  source      String   @default("manual") // manual | expense | sale | wage | advance | tipper
  category    String
  title       String
  notes       String?
  method      String   @default("cash") // cash | gpay | bank | upi | cheque

  expense       Expense?
  tipperLoad    TipperLoad?
  advance       Advance?
  clientPayment ClientPayment?
  employeePayout EmployeePayout?
  workerPayout  WorkerPayout?
  loadingCharge LoadingCharge?

  @@index([date])
}
